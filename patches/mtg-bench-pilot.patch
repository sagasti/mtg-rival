+    const m = t.match(/Sacrifice [^:]*: Add \{([WUBRGC])\}/i) ?? t.match(/Sacrifice [^:]*: Add one mana of any color/i);
+    if (m) { tokenMana++; addSource(m[1] ? [m[1].toUpperCase()] : ["W", "U", "B", "R", "G"]); continue; }
