+
+// ---------------------------------------------------------------------------------------------------------------------
+
+function cardGroups(c: CardDef, zone: "hand" | "graveyard", copies: number, you: Side, db: CardDb, oppLostLife: boolean | undefined): Group[] {
+  const out: Group[] = [];
+  const types = c.types ?? "";
